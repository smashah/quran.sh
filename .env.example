# Optional credentials enable Quran Foundation tafsir and hadith.
# Word-synchronized playback uses Quran.com's keyless public API.
# Copy this file to .env, then add credentials obtained from:
# https://api-docs.quran.com/request-access/
QF_CLIENT_ID=replace-with-your-client-id
QF_CLIENT_SECRET=replace-with-your-client-secret

# Supported values: production, prelive
QF_ENV=production
