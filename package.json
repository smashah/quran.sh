{
  "name": "quran.sh",
  "version": "0.7.1",
  "description": "A fast, offline-first Quran CLI and TUI reader",
  "type": "module",
  "bin": {
    "quran": "dist/index.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.scm",
    "dist/*.wasm",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "docs/**/*.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "quran",
    "islam",
    "cli",
    "tui",
    "terminal",
    "reader"
  ],
  "author": "smashah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smashah/quran.sh.git"
  },
  "bugs": "https://github.com/smashah/quran.sh/issues",
  "homepage": "https://github.com/smashah/quran.sh",
  "scripts": {
    "build": "bun run src/dev/build.ts",
    "build:binary": "bun build --compile --minify --sourcemap --format esm --splitting ./src/index.ts --outfile ./dist/quran",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run build && bun run build:binary && bun run smoke:builds",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "smoke:builds": "bun run src/dev/smoke-builds.ts",
    "test": "bun test",
    "perf": "bun run build && bun run src/dev/perf.ts",
    "verify:lazy": "bun run build && bun run src/dev/verify-lazy-build.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@m31coding/fuzzy-search": "^2.0.0",
    "@opentui/core": "0.4.5",
    "@opentui/react": "0.4.5",
    "@opentui/three": "0.4.5",
    "@tilawa/core": "0.1.0",
    "arabic-reshaper": "^1.1.0",
    "effect": "3.22.0",
    "fontkit": "^2.0.4",
    "pngjs": "^7.0.0",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/fontkit": "^2.0.9",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/three": "0.177.0",
    "quran-json": "^3.1.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "shell-quote": "1.10.0",
    "ws": "8.21.1"
  },
  "optionalDependencies": {
    "onnxruntime-node": "1.27.0"
  }
}
